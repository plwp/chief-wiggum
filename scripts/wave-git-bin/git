#!/usr/bin/env python3
"""PATH shim that routes wave-worker and hook Git calls through wave-git."""

from __future__ import annotations

import os
import subprocess
import sys


def main() -> int:
    required = ("CW_WAVE_MAIN", "CW_WAVE_GIT_SAFETY")
    missing = [name for name in required if not os.environ.get(name)]
    if missing:
        print(
            f"wave-git shim is missing required environment: {', '.join(missing)}",
            file=sys.stderr,
        )
        return 1
    return subprocess.call(
        [
            sys.executable,
            os.environ["CW_WAVE_GIT_SAFETY"],
            "wave-git",
            "--main",
            os.environ["CW_WAVE_MAIN"],
            "--worktree",
            os.getcwd(),
            "--",
            *sys.argv[1:],
        ]
    )


if __name__ == "__main__":
    raise SystemExit(main())
