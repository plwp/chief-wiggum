<!doctype html>
<!--
  Landing-page smoke test for {{product_name}} — stamped by chief-wiggum
  /apply-pattern (landing-page-smoke-test, #236). This is an EXPERIMENT
  scaffold, not a product page.

  INV-LPS-003 (honest framing): this page describes what {{product_name}}
  WILL do. Keep the "not built yet" block visible; never add fake logins,
  fabricated testimonials, or invented usage numbers.

  Before launch: pre-register the test card —
    python3 scripts/assumption.py card <bet-id> --asm ASM-NNN \
        --method landing-page-smoke-test --metric visitor_to_signup_rate_pct \
        --comparator ">=" --value <X> --sample-min <N> --evidence-strength 2
-->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{product_name}} — coming soon</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 40rem; margin: 4rem auto; padding: 0 1rem; line-height: 1.5; }
    .badge { display: inline-block; font-size: 0.8rem; padding: 0.2rem 0.6rem; border: 1px solid currentColor; border-radius: 1rem; }
    form { display: flex; gap: 0.5rem; margin-top: 1.5rem; }
    input[type=email] { flex: 1; padding: 0.6rem; font-size: 1rem; }
    button { padding: 0.6rem 1.2rem; font-size: 1rem; cursor: pointer; }
    .fine { font-size: 0.8rem; opacity: 0.7; }
    .done { display: none; }
  </style>
</head>
<body>
  <p class="badge">Not built yet — we are testing whether to build it</p>
  <h1>{{product_name}}</h1>
  <p>{{value_prop}}</p>

  <form id="signup-form">
    <input type="email" name="email" placeholder="you@example.com" required
           autocomplete="email">
    <button type="submit">{{cta_label}}</button>
  </form>
  <p id="signup-done" class="done">Thanks — we will only email you about {{product_name}}.</p>

  <p class="fine">
    Leaving your email tells us this is worth building and gets you early
    access if we build it. We store your address only to follow up about
    {{product_name}}, and delete it on request.
  </p>

  <script src="capture.js"></script>
</body>
</html>
