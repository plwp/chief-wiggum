{
  "version": 1,
  "providers": {
    "codex": {
      "type": "tool",
      "tool": "codex",
      "enabled": true,
      "reads_repo": true
    },
    "gemini": {
      "type": "tool",
      "tool": "gemini",
      "enabled": false,
      "reads_repo": true
    },
    "gemini-vertex": {
      "type": "tool",
      "tool": "gemini-vertex",
      "enabled": true,
      "reads_repo": true
    },
    "claude": {
      "type": "tool",
      "tool": "claude",
      "enabled": false,
      "reads_repo": true
    },
    "claude-interactive": {
      "type": "delegate",
      "delegate": "claude-interactive",
      "enabled": true,
      "reads_repo": true
    },
    "opus": {
      "type": "tool",
      "tool": "claude",
      "model": "claude-opus-4-6",
      "enabled": true,
      "reads_repo": true
    },
    "deepseek": {
      "type": "tool",
      "tool": "openrouter",
      "model": "deepseek/deepseek-v4-pro",
      "enabled": true,
      "reads_repo": false
    },
    "kimi": {
      "type": "tool",
      "tool": "openrouter",
      "model": "moonshotai/kimi-k3",
      "enabled": true,
      "reads_repo": false
    },
    "glm": {
      "type": "tool",
      "tool": "openrouter",
      "model": "z-ai/glm-5.2",
      "enabled": true,
      "reads_repo": false
    },
    "qwen": {
      "type": "tool",
      "tool": "openrouter",
      "model": "qwen/qwen3.7-max",
      "enabled": true,
      "reads_repo": false
    },
    "minimax": {
      "type": "tool",
      "tool": "openrouter",
      "model": "minimax/minimax-m3",
      "enabled": true,
      "reads_repo": false
    }
  },
  "roles": {
    "explorer": {
      "required": [
        "codex"
      ],
      "optional": [
        "gemini-vertex",
        "claude-interactive"
      ],
      "optional_timeout_seconds": 300,
      "requires_repo_read": true
    },
    "implementer": {
      "required": [
        "codex"
      ],
      "optional": [
        "claude-interactive"
      ],
      "optional_timeout_seconds": 300,
      "requires_repo_read": true
    },
    "reviewer": {
      "required": [
        "codex",
        "gemini-vertex"
      ],
      "optional": [
        "claude-interactive"
      ],
      "lenses": {
        "codex": "refute-soundness",
        "claude-interactive": "adoption-cost",
        "gemini-vertex": "completeness"
      },
      "optional_timeout_seconds": 300,
      "requires_repo_read": true
    },
    "architecture_critic": {
      "required": [
        "codex"
      ],
      "optional": [
        "gemini-vertex",
        "claude-interactive"
      ],
      "lenses": {
        "codex": "refute-soundness",
        "claude-interactive": "adoption-cost",
        "gemini-vertex": "completeness"
      },
      "optional_timeout_seconds": 300,
      "requires_repo_read": true
    },
    "design_critic": {
      "required": [
        "gemini-vertex"
      ],
      "optional": [
        "codex",
        "claude-interactive"
      ],
      "optional_timeout_seconds": 300,
      "requires_repo_read": false
    },
    "risky_diff_review": {
      "required": [
        "codex",
        "gemini-vertex"
      ],
      "optional": [
        "claude-interactive"
      ],
      "optional_timeout_seconds": 300,
      "requires_repo_read": true
    },
    "kill-review": {
      "required": [
        "codex",
        "opus"
      ],
      "optional": [
        "claude-interactive"
      ],
      "lenses": {
        "codex": "evidence-sufficiency",
        "opus": "steelman-the-kill",
        "claude-interactive": "is-recycle-better"
      },
      "optional_timeout_seconds": 300,
      "requires_repo_read": false
    },
    "divergence": {
      "required": [
        "deepseek",
        "kimi"
      ],
      "optional": [
        "glm",
        "qwen",
        "minimax"
      ],
      "optional_timeout_seconds": 300,
      "requires_repo_read": false
    }
